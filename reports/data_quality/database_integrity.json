  "queries": {
    "checks": "SELECT * FROM audit.checks ORDER BY severity, check_name",
    "raw_counts": "SELECT 'complaints' AS source, count(*) AS rows FROM raw.complaints\n        UNION ALL SELECT 'violations', count(*) FROM raw.violations\n        UNION ALL SELECT 'buildings', count(*) FROM raw.buildings\n        UNION ALL SELECT 'pluto', count(*) FROM raw.pluto",
    "pluto_versions": "SELECT pluto_version, count(*) AS lots FROM clean.pluto GROUP BY 1",
    "annual": "SELECT year(event_month) AS year, count(*) AS problems,\n        count(DISTINCT complaint_id) AS complaints,\n        count(*) FILTER (WHERE duplicate_flag='Y') AS flagged_problems\n        FROM clean.complaints WHERE in_study GROUP BY 1 ORDER BY 1",
    "linkage": "SELECT source, sum(rows) AS rows,\n        sum(building_unmatched) AS unmatched, sum(pluto_matched) AS pluto_matched,\n        sum(bbl_conflicts) AS bbl_conflicts, sum(bin_conflicts) AS bin_conflicts,\n        sum(source_bbl_conflicts) AS source_bbl_conflicts,\n        sum(component_bbl_conflicts) AS component_bbl_conflicts\n        FROM audit.linkage_summary WHERE in_study GROUP BY 1 ORDER BY 1",
    "coverage": "SELECT source, count(*) AS months,\n        count(*) FILTER (WHERE rows=0) AS empty_months,\n        min(rows) AS min_monthly_rows, max(rows) AS max_monthly_rows,\n        min(year_over_year_ratio) AS min_yoy, max(year_over_year_ratio) AS max_yoy\n        FROM audit.monthly_coverage GROUP BY 1 ORDER BY 1",
    "timing": "SELECT * FROM audit.violation_date_comparison ORDER BY extract_partition",
    "dates": "SELECT * FROM audit.date_quality ORDER BY source, extract_partition",
    "keys": "SELECT * FROM audit.key_cardinality ORDER BY key_type",
    "cohort": "SELECT * FROM audit.cohort_exclusions ORDER BY cohort_reason",
    "denominators": "SELECT borough_id, sum(candidate_buildings) AS candidates,\n        sum(with_denominator) AS retained,\n        round(100.0 * sum(with_denominator)/sum(candidate_buildings),2) AS retained_percent\n        FROM audit.denominator_selection GROUP BY 1 ORDER BY 1",
    "denominators_by_size": "SELECT apartment_band, sum(candidate_buildings) AS candidates,\n        sum(with_denominator) AS retained,\n        round(100.0 * sum(with_denominator)/sum(candidate_buildings),2) AS retained_percent\n        FROM audit.denominator_selection GROUP BY 1 ORDER BY 1",
    "outcomes": "SELECT cohort, sum(building_years) AS building_years,\n        sum(zero_complaint_and_bc_years) AS zero_complaint_and_bc_years,\n        sum(complaints) AS complaints, sum(problems) AS problems,\n        sum(hazardous) AS hazardous\n        FROM audit.outcome_selection GROUP BY 1 ORDER BY 1",
    "severity": "SELECT violation_class, sum(rows) AS violations\n        FROM audit.violation_classes GROUP BY 1 ORDER BY 1",
    "reconciliation": "SELECT * FROM audit.row_reconciliation ORDER BY source",
    "annual_panel": "SELECT year, count(*) AS buildings, min(calendar_months) AS min_months,\n        max(calendar_months) AS max_months,\n        count(*) FILTER (WHERE NOT source_coverage_present) AS incomplete_source_years\n        FROM mart.building_year GROUP BY 1 ORDER BY 1",
    "rolling_view": "SELECT count(*) AS months,\n        count(*) FILTER (WHERE complaints_12m IS NULL) AS incomplete_windows,\n        count(*) FILTER (WHERE months_in_window=12) AS full_windows\n        FROM mart.rolling_activity WHERE building_id=(SELECT min(building_id) FROM mart.buildings)",
    "peer_view": "SELECT count(*) AS building_years, min(raw_hazardous_rank) AS minimum_raw_rank,\n        min(unit_rate_rank) AS minimum_rate_rank, min(peer_buildings) AS minimum_peer_size\n        FROM mart.peer_comparisons"
  },
