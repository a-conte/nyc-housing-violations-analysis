{
  "queries": {
    "flagged_months": "WITH classes AS (\n SELECT event_month, count(*) FILTER (WHERE violation_class='A') class_a,\n count(*) FILTER (WHERE violation_class='I') class_i,\n count(*) FILTER (WHERE violation_class IN ('B','C')) hazardous\n FROM clean.violations WHERE in_study GROUP BY event_month\n), compared AS (\n SELECT m.*, class_a, class_i, hazardous, lag(hazardous,12) OVER (ORDER BY event_month) bc_prior_year\n FROM audit.monthly_coverage m JOIN classes USING (event_month) WHERE source='violations'\n) SELECT event_month, rows, rows_prior_year, round(year_over_year_ratio,3) AS total_ratio,\n class_a, class_i, hazardous, bc_prior_year,\n round(hazardous::DOUBLE/bc_prior_year,3) AS bc_ratio FROM compared\n WHERE year_over_year_ratio < 0.5 OR year_over_year_ratio > 2 ORDER BY event_month",
    "notice_missing_by_class": "SELECT violation_class, count(*) n FROM clean.violations WHERE notice_issued_at IS NULL GROUP BY 1 ORDER BY 1",
    "approval_dates": "SELECT inspected_at::DATE AS inspection_date, approved_at::DATE AS approval_date, count(*) n FROM clean.violations WHERE approved_at < inspected_at GROUP BY 1,2 ORDER BY n DESC LIMIT 10",
    "candidate_bin_overlap": "WITH shared AS (SELECT bin FROM clean.buildings WHERE record_status='ACTIVE' AND lifecycle='BUILDING' AND bin IS NOT NULL GROUP BY bin HAVING count(*)>1)\nSELECT count(*) AS candidates, count(rate_units) AS with_denominator FROM mart.buildings WHERE candidate_multifamily AND bin IN (SELECT bin FROM shared)",
    "category_missingness": "SELECT year, sum(problems) AS problems, sum(problems) FILTER (WHERE major_category IS NULL OR major_category='') AS missing_category, sum(unknown_duplicate_flag) AS unknown_duplicate_flag FROM audit.complaint_categories GROUP BY year ORDER BY year"
  },
